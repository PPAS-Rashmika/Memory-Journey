<Window x:Class="MemoryTimeline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Memory Timeline"
        Height="800" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <!-- Keyboard shortcut to toggle sidebar -->
    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Modern Sidebar Nav Button with smooth hover and active state -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: Width Auto collapses to 0 when hidden -->
            <ColumnDefinition Width="Auto"/>
            <!-- Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════ SIDEBAR ═══════════════════════════════════ -->
        <Border Grid.Column="0"
                Width="220"
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App Header with Logo and Collapse Button ◀ -->
                <Border DockPanel.Dock="Top"
                        Padding="16,18,12,18"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Camera Icon -->
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="📷" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- App Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Memory Timeline"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Hide Sidebar Button ◀ -->
                        <Button Grid.Column="2"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Hide sidebar (Ctrl+B)"
                                Width="28" Height="28"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="4">
                                        <TextBlock x:Name="Txt" Text="◀" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Bottom: Theme toggle -->
                <Border DockPanel.Dock="Bottom"
                        Padding="12,12"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌙" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Toggle Theme" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Navigation Items (Simplified without loud uppercase headers) -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <!-- Primary Section -->
                        <!-- Dashboard -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Dashboard"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                            <Setter Property="Background" Value="#22E94560"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Timeline (Winding Memory Line) -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Timeline"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Timeline">
                                            <Setter Property="Background" Value="#22E94560"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="〰️" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Timeline" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Calendar -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Calendar"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Calendar">
                                            <Setter Property="Background" Value="#22E94560"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Calendar" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Gallery -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Gallery"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Gallery">
                                            <Setter Property="Background" Value="#22E94560"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼️" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Gallery" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Subtle Divider -->
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="16,10" Opacity="0.4"/>

                        <!-- Milestones -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Milestones"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Milestones">
                                            <Setter Property="Background" Value="#22E94560"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Milestones" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Favorites -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Favorites"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Favorites">
                                            <Setter Property="Background" Value="#22E94560"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❤️" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Favorites" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Subtle Divider -->
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="16,10" Opacity="0.4"/>

                        <!-- Settings -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Settings"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                            <Setter Property="Background" Value="#22E94560"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════ CONTENT AREA ═══════════════════════════════════ -->
        <DockPanel Grid.Column="1">
            <!-- Slim Top Bar visible ONLY when Sidebar is Hidden -->
            <Border DockPanel.Dock="Top"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Re-open Sidebar Button ☰ -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Show Sidebar (Ctrl+B)"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="☰" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Show Menu" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Breadcrumb / Active View Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Memory Timeline • " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CurrentView}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content View -->
            <ContentControl x:Name="MainContent"
                            Background="{DynamicResource BackgroundBrush}"/>
        </DockPanel>

    </Grid>
</Window>
