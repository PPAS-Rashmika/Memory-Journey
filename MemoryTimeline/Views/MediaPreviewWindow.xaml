<Window x:Class="MemoryTimeline.Views.MediaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Preview"
        Width="960" Height="720"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Display Area -->
        <Grid Grid.Row="0">
            <!-- Image display -->
            <Image x:Name="PreviewImage"
                   Stretch="Uniform" Margin="24"/>

            <!-- Video Player -->
            <Grid x:Name="VideoPlayerGrid" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <MediaElement x:Name="VideoElement" Grid.Row="0"
                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Video Controls Bar -->
                <Border Grid.Row="1" Background="#E61A1A1A" CornerRadius="8"
                        Padding="14,10" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnPlay" Content="▶ Play"
                                Padding="12,6" FontSize="12" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="2" x:Name="BtnPause" Content="⏸ Pause"
                                Padding="12,6" FontSize="12" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="4" x:Name="BtnStop" Content="⏹ Stop"
                                Padding="12,6" FontSize="12" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                        <Slider Grid.Column="6" x:Name="TimelineSlider" VerticalAlignment="Center"/>

                        <Button Grid.Column="8" x:Name="OpenVideoBtn" Content="↗ External Player"
                                Padding="12,6" FontSize="12" Background="#444" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Missing File Notification & Relink Option -->
            <Border x:Name="MissingFilePanel"
                    Background="#2A1B1B" BorderBrush="#E94560" BorderThickness="1.5"
                    CornerRadius="12" Padding="32" MaxWidth="580"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ Original Media File Missing" FontSize="20" FontWeight="Bold"
                               Foreground="#E94560" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="MissingPathLabel" Foreground="#E0E0E0" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,12" TextAlignment="Center"/>
                    <TextBlock Text="This media was imported using 'Original File Location' mode. The file may have been moved, renamed, or deleted."
                               Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20" TextAlignment="Center"/>
                    <Button x:Name="RelinkBtn" Content="🔗 Relink File..."
                            Padding="24,10" FontSize="14" FontWeight="SemiBold"
                            Background="#E94560" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Status & Navigation Bar -->
        <Border Grid.Row="1" Background="#161616" Padding="20,12"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Storage Mode Badge -->
                <Border Grid.Column="0" x:Name="StorageModeBadge"
                        Padding="8,3" CornerRadius="4" Background="#333" VerticalAlignment="Center">
                    <TextBlock x:Name="StorageModeLabel" Text="App Storage"
                               Foreground="#DDD" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <!-- File Info -->
                <TextBlock Grid.Column="2" x:Name="FileNameLabel"
                           Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" x:Name="MemoryLabel"
                           Foreground="#777" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Favorite Toggle -->
                <Button Grid.Column="4" x:Name="BtnFavorite"
                        Content="❤️ Favorite" Padding="12,6" FontSize="12"
                        Background="#262626" Foreground="White" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center"/>

                <!-- Navigation Next / Prev -->
                <Button Grid.Column="6" x:Name="PrevBtn" Content="◀ Previous"
                        Foreground="#CCC" Background="#262626" BorderThickness="0"
                        FontSize="12" Padding="14,6" Cursor="Hand" VerticalAlignment="Center"/>

                <Button Grid.Column="8" x:Name="NextBtn" Content="Next ▶"
                        Foreground="#CCC" Background="#262626" BorderThickness="0"
                        FontSize="12" Padding="14,6" Cursor="Hand" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
