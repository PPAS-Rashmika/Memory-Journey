<Window x:Class="MemoryTimeline.Views.MemoryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Details"
        Height="700" Width="800"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Title, Milestone, Date -->
        <Border Grid.Row="0" Margin="0,0,0,20" Padding="0,0,0,16"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock x:Name="TxtMilestoneBadge" Text="⭐ MILESTONE"
                                   FontSize="12" FontWeight="Bold" Foreground="#F5A623"
                                   Margin="0,0,10,0" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtFavoriteBadge" Text="❤️ FAVORITE"
                                   FontSize="12" FontWeight="Bold" Foreground="#E94560"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTitle" Style="{DynamicResource HeadingStyle}"
                               FontSize="24" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="📅" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDate" Style="{DynamicResource SubHeadingStyle}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Location & Map -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel x:Name="LocationPanel" Orientation="Horizontal" Visibility="Collapsed" HorizontalAlignment="Right">
                        <TextBlock Text="📍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLocation" Style="{DynamicResource SubHeadingStyle}"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnViewOnMap" Content="🗺️ View on Map" Margin="0,6,0,0"
                            Padding="10,4" FontSize="11" HorizontalAlignment="Right"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Description Section -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Description" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtDescription" Style="{DynamicResource BodyStyle}"
                                   FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- Tags Section -->
                <StackPanel x:Name="TagsSection" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock Text="Tags" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="TagsWrapPanel"/>
                </StackPanel>

                <!-- Google Drive Integration Section -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Google Drive Document" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                        <!-- When URL exists -->
                        <Grid x:Name="DriveAttachedPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="📁 Linked Google Drive document available"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtDriveUrl" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnOpenDrive" Content="🔗 Open Google Drive"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Padding="16,8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- When URL is empty -->
                        <TextBlock x:Name="TxtNoDrive" Text="No Google Drive link has been attached to this memory."
                                   Style="{DynamicResource SubHeadingStyle}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Media Attachments Section -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <TextBlock x:Name="TxtMediaHeader" Text="Media Attachments (0)"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtNoMedia" Text="No photos or videos attached to this memory."
                                   Style="{DynamicResource SubHeadingStyle}" FontSize="13" Visibility="Collapsed"/>
                        <WrapPanel x:Name="MediaWrapPanel"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,14,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnDelete" Content="🗑️ Delete Memory"
                        Background="#C0392B" Foreground="White"
                        BorderThickness="0" Padding="14,8" FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" x:Name="BtnEdit" Content="✏️ Edit Memory"
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="18,8" FontSize="13" FontWeight="SemiBold"/>

                <Button Grid.Column="4" x:Name="BtnClose" Content="Close"
                        Padding="18,8" FontSize="13"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
