<UserControl x:Class="MemoryTimeline.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Calendar" Style="{DynamicResource HeadingStyle}" FontSize="22"/>
                <!-- View toggle: Year, Month, Week -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Year" x:Name="YearViewBtn"
                            Padding="14,8" Margin="0,0,6,0" FontSize="13" Cursor="Hand"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Month" x:Name="MonthViewBtn"
                            Padding="14,8" Margin="0,0,6,0" FontSize="13" Cursor="Hand"
                            Style="{DynamicResource AccentButtonStyle}"/>
                    <Button Content="Week" x:Name="WeekViewBtn"
                            Padding="14,8" FontSize="13" Cursor="Hand"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation bar -->
        <Border Grid.Row="1" Padding="24,10" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Content="◀" Command="{Binding GoToPreviousCommand}"
                        Padding="10,6" FontSize="14" Background="Transparent"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0" Cursor="Hand"/>
                <TextBlock x:Name="PeriodLabel"
                           VerticalAlignment="Center" Margin="12,0"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="▶" Command="{Binding GoToNextCommand}"
                        Padding="10,6" FontSize="14" Background="Transparent"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0" Cursor="Hand"/>
                <Button Content="Today" Command="{Binding GoToTodayCommand}"
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="14,6" FontSize="12" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Calendar content area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Main calendar panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16">

                    <!-- YEAR VIEW -->
                    <UniformGrid x:Name="YearGrid" Columns="4" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding YearSummary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6" Padding="16,12" CornerRadius="10"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonUp="OnMonthCardClick">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MonthName}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding MemoryCount, Converter={StaticResource CountToString}, ConverterParameter=memory}"
                                                       Style="{DynamicResource SubHeadingStyle}"
                                                       FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="⭐ Milestone" FontSize="11"
                                                       Foreground="#F5A623" Margin="0,4,0,0"
                                                       Visibility="{Binding HasMilestone, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </UniformGrid>

                    <!-- MONTH VIEW -->
                    <StackPanel x:Name="MonthGrid" Visibility="Visible">
                        <!-- Day-of-week headers -->
                        <UniformGrid Columns="7" Margin="0,0,0,4">
                            <TextBlock Text="Sun" HorizontalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Mon" HorizontalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Tue" HorizontalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Wed" HorizontalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Thu" HorizontalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Fri" HorizontalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Sat" HorizontalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </UniformGrid>

                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="85" Margin="2" Padding="6"
                                            CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonUp="OnDayClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="#22E94560"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Day number and milestone indicator -->
                                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DayNumber}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="⭐" FontSize="11"
                                                           Foreground="#F5A623"
                                                           Visibility="{Binding HasMilestone, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>

                                            <!-- Event name(s) under the date -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                                <ItemsControl ItemsSource="{Binding DisplayMemories}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,1,0,3" Padding="5,2" CornerRadius="4"
                                                                    ToolTip="{Binding Title}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter Property="Opacity" Value="0.9"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMilestone}" Value="True">
                                                                                <Setter Property="Background" Value="#F5A623"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="⭐ " FontSize="9"
                                                                               Visibility="{Binding IsMilestone, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Extra events badge if more than 2 -->
                                                <Border Margin="0,1,0,0" Padding="4,1" CornerRadius="3"
                                                        Background="#20FFFFFF" HorizontalAlignment="Left"
                                                        Visibility="{Binding HasExtraMemories, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding ExtraMemoriesLabel}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- WEEK VIEW -->
                    <UniformGrid x:Name="WeekGrid" Columns="7" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding WeekDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" MinHeight="400" Padding="10"
                                            CornerRadius="10"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="OnWeekDayClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DayName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DayNumber}"
                                                       FontSize="22" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Memories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="6,4" Margin="0,2" CornerRadius="6"
                                                                Background="{DynamicResource AccentBrush}" Opacity="0.8">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="White" FontSize="11"
                                                                       TextWrapping="Wrap"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>

            <!-- Selected Date Details Panel -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Background="{DynamicResource CardBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Selected Date"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SelectedDate, Converter={StaticResource DateFormat}, ConverterParameter='MMMM d, yyyy'}"
                                   Style="{DynamicResource SubHeadingStyle}"
                                   Margin="0,0,0,16"
                                   Visibility="{Binding SelectedDate, Converter={StaticResource NullToVisibility}}"/>
                        <TextBlock Text="Click a date to see memories"
                                   Style="{DynamicResource SubHeadingStyle}"
                                   Visibility="{Binding SelectedDate, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>

                        <ItemsControl ItemsSource="{Binding SelectedDateMemories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" Margin="0,0,0,8" CornerRadius="8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="OnCalendarMemoryClick">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IsMilestone, Converter={StaticResource MilestoneToIcon}}"
                                                           FontSize="13" Margin="0,0,4,0"
                                                           Visibility="{Binding IsMilestone, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LocationName}"
                                                       Style="{DynamicResource SubHeadingStyle}"
                                                       FontSize="11" Margin="0,3,0,0"
                                                       Visibility="{Binding LocationName, Converter={StaticResource StringToVisibility}}"/>
                                            <TextBlock Text="{Binding MediaItems.Count, Converter={StaticResource CountToString}, ConverterParameter=photo}"
                                                       Style="{DynamicResource SubHeadingStyle}"
                                                       FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
