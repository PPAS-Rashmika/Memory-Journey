<UserControl x:Class="MemoryTimeline.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Favorites ❤️" Style="{DynamicResource HeadingStyle}" FontSize="22"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Favorite Memories -->
                <TextBlock Text="Favorite Memories" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="No favorite memories yet. Mark a memory as favorite to see it here!"
                           Style="{DynamicResource SubHeadingStyle}" TextWrapping="Wrap"
                           Visibility="{Binding FavoriteMemories.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                           Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding FavoriteMemories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="16" CornerRadius="10"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonUp="OnFavoriteMemoryClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="❤️" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MemoryDate, Converter={StaticResource DateFormat}, ConverterParameter='MMMM d, yyyy'}"
                                                   Style="{DynamicResource SubHeadingStyle}" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding LocationName}"
                                                   Style="{DynamicResource SubHeadingStyle}" FontSize="12"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding LocationName, Converter={StaticResource StringToVisibility}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="💔 Remove"
                                            Command="{Binding DataContext.UnfavoriteMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="12,6" FontSize="12"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Cursor="Hand" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Separator -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                <!-- Favorite Media -->
                <TextBlock Text="Favorite Photos &amp; Videos" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="No favorite media yet. Mark photos or videos as favorite in the Gallery!"
                           Style="{DynamicResource SubHeadingStyle}" TextWrapping="Wrap"
                           Visibility="{Binding FavoriteMedia.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                <ItemsControl ItemsSource="{Binding FavoriteMedia}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="140" Height="140" Margin="6" CornerRadius="10"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonUp="OnFavoriteMediaClick">
                                <Grid>
                                    <!-- Video / fallback icon when no thumbnail image -->
                                    <TextBlock Text="{Binding MediaType, Converter={StaticResource MediaTypeToIcon}}"
                                               FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.5"/>

                                    <!-- Image / Video thumbnail: passes entire MediaItem to support local & cloud -->
                                    <Image Source="{Binding Converter={StaticResource PathToImage}}"
                                           Stretch="UniformToFill"/>

                                    <!-- Video play icon overlay -->
                                    <Border Background="#80000000" CornerRadius="16" Width="32" Height="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding MediaType, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Video}">
                                        <TextBlock Text="▶" Foreground="White" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Border>

                                    <!-- Storage badge (top-right) -->
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                            Background="#D01A1A2E" CornerRadius="4" Padding="5,2" Margin="6">
                                        <TextBlock Text="{Binding Converter={StaticResource StorageModeToBadge}}"
                                                   Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Overlay at bottom with file name -->
                                    <Border VerticalAlignment="Bottom" CornerRadius="0,0,10,10"
                                            Background="#CC000000" Padding="6,4">
                                        <TextBlock Text="{Binding FileName}" Foreground="White"
                                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
