<UserControl x:Class="MemoryTimeline.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MemoryTimeline.Controls"
             Background="{DynamicResource BackgroundBrush}"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Reusable Memory Card DataTemplate matching the hand-drawn sketch -->
        <DataTemplate x:Key="MemoryCardTemplate">
            <Border Padding="16"
                    CornerRadius="14"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    MouseLeftButtonUp="OnCardClick"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Memory.IsMilestone}" Value="True">
                                <Setter Property="BorderBrush" Value="#F5A623"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- ======================================================== -->
                    <!-- TOP SECTION: Media Preview Row matching sketch [ ][ ][ ] 5+ -->
                    <!-- ======================================================== -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">

                        <!-- Up to 3 preview thumbnails -->
                        <ItemsControl ItemsSource="{Binding PreviewMedia}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="86" Height="86" Margin="0,0,8,0"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="#FFD166" BorderThickness="1.5"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="OnTimelineMediaThumbClick">
                                        <Grid>
                                            <!-- Fallback icon centered in tile -->
                                            <TextBlock Text="{Binding MediaType, Converter={StaticResource MediaTypeToIcon}}"
                                                       FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.45"/>

                                            <!-- Thumbnail image: local and cloud supported -->
                                            <Image Source="{Binding Converter={StaticResource PathToImage}}"
                                                   Stretch="UniformToFill"/>

                                            <!-- Play icon overlay for videos -->
                                            <Border Background="#90000000" CornerRadius="15" Width="30" Height="30"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding MediaType, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Video}">
                                                <TextBlock Text="▶" Foreground="White" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </Border>

                                            <!-- Storage badge (top-right) -->
                                            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Background="#D01A1A2E" CornerRadius="4" Padding="4,2" Margin="4">
                                                <TextBlock Text="{Binding Converter={StaticResource StorageModeToBadge}}"
                                                           Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Truncated file name at bottom -->
                                            <Border VerticalAlignment="Bottom" Background="#B0000000" CornerRadius="0,0,7,7" Padding="4,2">
                                                <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="9"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Remaining count overflow badge (e.g. 5+, 10+, 2+ in the sketch!) -->
                        <Border Width="86" Height="86" CornerRadius="8" Margin="0,0,8,0"
                                Background="#33FFD166"
                                BorderBrush="#FFD166" BorderThickness="1.5"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnMoreMediaBadgeClick"
                                ToolTip="{Binding TotalMediaCount, StringFormat='Click to view all {0} photos &amp; videos'}"
                                Visibility="{Binding HasRemainingMedia, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RemainingMediaBadge}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#FFD166"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="more"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#FFD166" Opacity="0.85"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- MIDDLE SECTION: Title and Action Buttons                  -->
                    <!-- ======================================================== -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title + Milestone Star + Favorite Heart -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Memory.IsMilestone, Converter={StaticResource MilestoneToIcon}}"
                                       FontSize="16" Margin="0,0,6,0"
                                       Visibility="{Binding Memory.IsMilestone, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding Memory.Title}"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="❤️" FontSize="14" Margin="8,0,0,0"
                                       Visibility="{Binding Memory.IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="✏️" Click="OnEditClick" Background="Transparent" BorderThickness="0"
                                    FontSize="15" Cursor="Hand" Margin="2,0" ToolTip="Edit Memory"/>
                            <Button Content="🗑️" Click="OnDeleteClick" Background="Transparent" BorderThickness="0"
                                    FontSize="15" Cursor="Hand" Margin="2,0" ToolTip="Delete Memory"/>
                        </StackPanel>
                    </Grid>

                    <!-- METADATA: Date & Location -->
                    <WrapPanel Margin="0,0,0,8">
                        <!-- Date Pill -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                Padding="8,3" Margin="0,0,8,4"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Memory.MemoryDate, Converter={StaticResource DateFormat}, ConverterParameter='MMM d, yyyy'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Location Pill -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                Padding="8,3" Margin="0,0,8,4"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding Memory.LocationName, Converter={StaticResource StringToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📍" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Memory.LocationName}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- DESCRIPTION -->
                    <TextBlock Text="{Binding Memory.Description, Converter={StaticResource Truncate}, ConverterParameter=150}"
                               Style="{DynamicResource BodyStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding Memory.Description, Converter={StaticResource StringToVisibility}}"/>

                    <!-- TAGS -->
                    <ItemsControl ItemsSource="{Binding Memory.Tags}"
                                  Visibility="{Binding Memory.Tags.Count, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="0,0,0,8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,3" CornerRadius="10" Margin="0,0,6,4"
                                        Background="{DynamicResource AccentBrush}" Opacity="0.85">
                                    <TextBlock Text="{Binding Tag.Name}" Foreground="White" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- GOOGLE DRIVE CLOUD LINK -->
                    <Border Margin="0,4,0,0" Padding="10,6" CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MouseLeftButtonUp="OnDriveLinkMouseUp"
                            Cursor="Hand"
                            Visibility="{Binding Memory.GoogleDriveUrl, Converter={StaticResource StringToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="☁️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Google Drive Cloud Document" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Memory.GoogleDriveUrl}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="↗ Open in Drive"
                                    Click="OnOpenDriveButtonClick"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Padding="10,4" FontSize="11" FontWeight="SemiBold"
                                    VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Padding="24,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Memory Timeline" Style="{DynamicResource HeadingStyle}" FontSize="22"/>
                    <TextBlock Text="Your life story, chronologically"
                               Style="{DynamicResource SubHeadingStyle}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180" Padding="0,8" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0" FontSize="13"
                                 x:Name="SearchBox"/>
                    </StackPanel>
                </Border>

                <!-- Milestones Only filter -->
                <CheckBox Grid.Column="3" Content="Milestones Only"
                          IsChecked="{Binding ShowMilestonesOnly}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalAlignment="Center"/>

                <!-- View Mode Toggle: Serpentine Winding vs Classic Single Column -->
                <Button Grid.Column="5"
                        Command="{Binding ToggleViewModeCommand}"
                        Padding="12,8" FontSize="12" FontWeight="SemiBold"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Toggle between Winding Memory Line and Classic View">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="〰️" Margin="0,0,5,0"/>
                        <TextBlock Text="Toggle View"/>
                    </StackPanel>
                </Button>

                <!-- + Add Memory -->
                <Button Grid.Column="7" Content="+ Add Memory"
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="16,9" FontSize="13" FontWeight="SemiBold"
                        x:Name="AddBtn"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16,20">
                <!-- Loading -->
                <TextBlock Text="Loading..." Style="{DynamicResource SubHeadingStyle}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                           HorizontalAlignment="Center" Margin="0,40,0,0"/>

                <!-- Empty State (when TimelineItems is empty) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0"
                            Visibility="{Binding TimelineItems.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock Text="No memories yet 📖"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Create your first memory to start your winding memory line"
                               Style="{DynamicResource SubHeadingStyle}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- ============================================== -->
                <!-- 1. WINDING SERPENTINE TIMELINE (DEFAULT VIEW) -->
                <!-- ============================================== -->
                <ItemsControl ItemsSource="{Binding TimelineItems}"
                              Visibility="{Binding IsWindingView, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <!-- Left Card Column -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Center Serpentine Spine (Width 140) -->
                                    <ColumnDefinition Width="140"/>
                                    <!-- Right Card Column -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT CARD (Visible when IsLeft is true) -->
                                <ContentControl Grid.Column="0"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource MemoryCardTemplate}"
                                                HorizontalAlignment="Right"
                                                MaxWidth="490"
                                                Margin="10,0,0,0"
                                                Visibility="{Binding IsLeft, Converter={StaticResource BoolToVisibility}}"/>

                                <!-- CENTER SERPENTINE SPINE -->
                                <controls:TimelineSpine Grid.Column="1"
                                                        Width="140"
                                                        HorizontalAlignment="Center"
                                                        IsLeft="{Binding IsLeft}"
                                                        IsFirst="{Binding IsFirst}"
                                                        IsLast="{Binding IsLast}"
                                                        IsMilestone="{Binding Memory.IsMilestone}"/>

                                <!-- RIGHT CARD (Visible when IsRight is true) -->
                                <ContentControl Grid.Column="2"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource MemoryCardTemplate}"
                                                HorizontalAlignment="Left"
                                                MaxWidth="490"
                                                Margin="0,0,10,0"
                                                Visibility="{Binding IsRight, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============================================== -->
                <!-- 2. CLASSIC SINGLE-COLUMN TIMELINE (TOGGLE VIEW)-->
                <!-- ============================================== -->
                <ItemsControl ItemsSource="{Binding TimelineItems}"
                              Visibility="{Binding IsWindingView, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource MemoryCardTemplate}"
                                            MaxWidth="650"
                                            HorizontalAlignment="Center"
                                            Margin="0,6,0,12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
