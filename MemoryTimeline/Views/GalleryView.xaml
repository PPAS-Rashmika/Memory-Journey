<UserControl x:Class="MemoryTimeline.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Media Gallery" Style="{DynamicResource HeadingStyle}" FontSize="22"/>
                    <TextBlock Text="Browse all your photos and videos"
                               Style="{DynamicResource SubHeadingStyle}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Padding="0,8" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0" FontSize="13"
                                 x:Name="SearchBox"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Padding="24,10" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <!-- Type filter -->
                <ComboBox ItemsSource="{Binding TypeFilters}"
                          SelectedItem="{Binding SelectedTypeFilter}"
                          Padding="10,6" Margin="0,0,12,0" MinWidth="100"
                          Background="{DynamicResource CardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Year filter -->
                <ComboBox ItemsSource="{Binding AvailableYears}"
                          SelectedItem="{Binding SelectedYear}"
                          Padding="10,6" Margin="0,0,12,0" MinWidth="80"
                          Background="{DynamicResource CardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderBrush}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Favorites toggle -->
                <CheckBox Content="❤️ Favorites Only"
                          IsChecked="{Binding FavoritesOnly}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Apply -->
                <Button Content="Apply Filters"
                        Command="{Binding ApplyFiltersCommand}"
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="14,6" FontSize="12" Margin="0,0,8,0"/>

                <!-- Clear -->
                <Button Content="Clear"
                        Command="{Binding ClearFiltersCommand}"
                        Padding="14,6" FontSize="12"
                        Background="{DynamicResource CardBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Count -->
                <TextBlock Text="{Binding MediaItems.Count, Converter={StaticResource CountToString}, ConverterParameter=item}"
                           Style="{DynamicResource SubHeadingStyle}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Gallery Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,16">
                <!-- Loading -->
                <TextBlock Text="Loading..."
                           Style="{DynamicResource SubHeadingStyle}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                           HorizontalAlignment="Center"/>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock Text="No media found 🖼️"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Visibility="{Binding MediaItems.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding MediaItems}"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Height="160" Margin="6" CornerRadius="10"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonUp="OnMediaCardClick">
                                <Grid>
                                    <!-- Video / fallback icon when no thumbnail image -->
                                    <TextBlock Text="{Binding MediaType, Converter={StaticResource MediaTypeToIcon}}"
                                               FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.5"/>

                                    <!-- Thumbnail: passes entire MediaItem so local and cloud are supported -->
                                    <Image Source="{Binding Converter={StaticResource PathToImage}}"
                                           Stretch="UniformToFill"/>

                                    <!-- Video play icon overlay -->
                                    <Border Background="#80000000" CornerRadius="18" Width="36" Height="36"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding MediaType, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Video}">
                                        <TextBlock Text="▶" Foreground="White" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Border>

                                    <!-- Storage badge (top-right) -->
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                            Background="#D01A1A2E" CornerRadius="4" Padding="5,2" Margin="6">
                                        <TextBlock Text="{Binding Converter={StaticResource StorageModeToBadge}}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Overlay at bottom with file name and favorite -->
                                    <Border VerticalAlignment="Bottom" CornerRadius="0,0,10,10"
                                            Background="#CC000000" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FileName}"
                                                       Foreground="White" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="❤️" FontSize="12"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
