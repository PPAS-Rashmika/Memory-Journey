<Window x:Class="MemoryTimeline.Views.AddEditMemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Width="780" Height="820"
        MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding TitleText}" Style="{DynamicResource HeadingStyle}" FontSize="22"/>
            <!-- Validation message -->
            <Border Background="#E94560" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                    Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ValidationMessage}" Foreground="White" FontSize="13"/>
            </Border>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Title -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Memory Title *" Style="{DynamicResource SubHeadingStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Date + Location row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Memory Date *" Style="{DynamicResource SubHeadingStyle}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding MemoryDate}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Location" Style="{DynamicResource SubHeadingStyle}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="PickOnMapBtn" Content="🗺️ Pick on Map"
                                    Padding="8,2" FontSize="11"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <TextBox Text="{Binding LocationName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="14"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"/>
                        <!-- Coordinates indicator if picked -->
                        <TextBlock Text="{Binding CoordinateDisplay}"
                                   Style="{DynamicResource SubHeadingStyle}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding HasCoordinates, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <!-- Description -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Description" Style="{DynamicResource SubHeadingStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14" MinHeight="90"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Tags -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Tags (comma separated)" Style="{DynamicResource SubHeadingStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TagsInput, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Google Drive URL -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Google Drive Document / Folder Link (optional)" Style="{DynamicResource SubHeadingStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding GoogleDriveUrl, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Flags -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <CheckBox IsChecked="{Binding IsMilestone}"
                              Content="⭐ Mark as Milestone"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="13" Margin="0,0,24,0"/>
                    <CheckBox IsChecked="{Binding IsFavorite}"
                              Content="❤️ Add to Favorites"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="13"/>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- 1. PREVIEW PHOTO (COVER IMAGE)                             -->
                <!-- ======================================================== -->
                <StackPanel Margin="0,0,0,18">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖼️ Preview Photo (Cover)" Style="{DynamicResource SubHeadingStyle}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text=" - Featured thumbnail on timeline" Style="{DynamicResource SubHeadingStyle}" FontSize="11" Opacity="0.7" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📁 Choose Local Photo"
                                Click="ChoosePreviewPhoto_Click"
                                Style="{DynamicResource AccentButtonStyle}"
                                Padding="12,5" FontSize="11"/>
                        <Button Grid.Column="3" Content="☁️ Cloud Photo"
                                Command="{Binding TogglePreviewCloudCommand}"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="12,5" FontSize="11"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Cloud URL Input for Preview Photo -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding IsPreviewCloudOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Enter Cloud Photo URL (Google Drive, Google Photos, or Web Image):"
                                       Style="{DynamicResource SubHeadingStyle}" FontSize="11" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PreviewCloudUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="12"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                                <Button Grid.Column="2" Content="✓ Set as Preview"
                                        Command="{Binding SetCloudPreviewPhotoCommand}"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Padding="14,6" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- When NO preview photo is selected -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                            CornerRadius="10" Padding="18"
                            Background="{DynamicResource SurfaceBrush}"
                            Cursor="Hand"
                            MouseLeftButtonUp="ChoosePreviewPhoto_Click"
                            Visibility="{Binding HasPreviewPhoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📷" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.5"/>
                            <TextBlock Text="No preview photo included"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Click to choose a preview photo (or select from files below)"
                                       Style="{DynamicResource SubHeadingStyle}" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- When a preview photo IS selected: Card with thumbnail preview -->
                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                            CornerRadius="10" Padding="12"
                            Background="{DynamicResource CardBrush}"
                            Visibility="{Binding HasPreviewPhoto, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail Preview Box -->
                            <Border Grid.Column="0" Width="130" Height="95" CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="🖼️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                    <Image Source="{Binding PreviewPhotoPath, Converter={StaticResource PathToImage}}"
                                           Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <!-- Preview Photo Info -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#25E94560" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="⭐ Preview Photo" Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding PreviewPhotoStorageLabel}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding PreviewPhotoFileName}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PreviewPhotoPath}"
                                           Style="{DynamicResource SubHeadingStyle}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" Opacity="0.7"/>
                            </StackPanel>

                            <!-- Remove Preview Button -->
                            <Button Grid.Column="3"
                                    Command="{Binding RemovePreviewPhotoCommand}"
                                    ToolTip="Remove preview photo"
                                    Width="30" Height="30"
                                    VerticalAlignment="Top"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <TextBlock Text="✕" FontSize="16" Foreground="#E94560"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- 2. ALL ATTACHED PHOTOS & VIDEOS                           -->
                <!-- ======================================================== -->
                <StackPanel Margin="0,0,0,14">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Attached Photos &amp; Videos"
                                   Style="{DynamicResource SubHeadingStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="📁 Copy to App"
                                Style="{DynamicResource AccentButtonStyle}"
                                Padding="10,6" FontSize="11"
                                x:Name="AddCopyBtn"/>
                        <Button Grid.Column="3" Content="🔗 Link Original"
                                Padding="10,6" FontSize="11"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                x:Name="AddLinkBtn">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="5" Content="☁️ Add Cloud Link"
                                Command="{Binding ToggleCloudInputCommand}"
                                Padding="10,6" FontSize="11"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Cloud Media Input Panel -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding IsCloudInputOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="☁️ Add Cloud Photo or Video Link" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Cloud URL (Google Drive, Google Photos, OneDrive, Dropbox, or Web Link):"
                                       Style="{DynamicResource SubHeadingStyle}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CloudUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12" Margin="0,0,0,8"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Label / Title (optional):" Style="{DynamicResource SubHeadingStyle}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CloudNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" FontSize="12"
                                             Background="{DynamicResource SurfaceBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Media Type:" Style="{DynamicResource SubHeadingStyle}" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding CloudTypeInput, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Content"
                                              Padding="8,6" FontSize="12"
                                              Background="{DynamicResource SurfaceBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ComboBoxItem Content="Photo" IsSelected="True"/>
                                        <ComboBoxItem Content="Video"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding ToggleCloudInputCommand}"
                                        Padding="14,6" FontSize="12" Margin="0,0,8,0"
                                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="✓ Attach Cloud Media" Command="{Binding AddCloudMediaItemCommand}"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Padding="16,6" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Media List with Visual Image Thumbnails -->
                    <ItemsControl ItemsSource="{Binding PendingMedia}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="8"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Live Image Thumbnail Preview -->
                                        <Border Grid.Column="0" Width="54" Height="54" CornerRadius="6"
                                                Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                ClipToBounds="True">
                                            <Grid>
                                                <!-- Fallback icon -->
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="20"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                                <!-- Image -->
                                                <Image Source="{Binding Converter={StaticResource PathToImage}}"
                                                       Stretch="UniformToFill"/>
                                                <!-- Play overlay for videos -->
                                                <Border Background="#80000000" CornerRadius="11" Width="22" Height="22"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding MediaType, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Video}">
                                                    <TextBlock Text="▶" Foreground="White" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- File Info -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="⭐ Primary Preview"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Margin="8,0,0,0"
                                                           Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FilePath}"
                                                       Style="{DynamicResource SubHeadingStyle}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" Opacity="0.7"/>
                                        </StackPanel>

                                        <!-- Storage Badge -->
                                        <Border Grid.Column="3" Padding="6,3" CornerRadius="4"
                                                Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModeLabel}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        </Border>

                                        <!-- "Set as Preview" button (only for photos that aren't already preview) -->
                                        <Button Grid.Column="5" Content="Set as Preview"
                                                Click="MakePreviewBtn_Click"
                                                Padding="8,4" FontSize="11"
                                                Background="Transparent"
                                                Foreground="{DynamicResource AccentBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsPhoto, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="7" Content="✕"
                                                Click="RemoveBtn_Click"
                                                Foreground="#E94560" Background="Transparent"
                                                BorderThickness="0" FontSize="15" Cursor="Hand"
                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Delete (edit mode only) -->
            <Button Grid.Column="0"
                    Content="🗑️ Delete Memory"
                    Command="{Binding DeleteCommand}"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"
                    Background="#C0392B" Foreground="White"
                    BorderThickness="0" Padding="14,10" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Cancel -->
            <Button Grid.Column="2"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="20,10" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Save -->
            <Button Grid.Column="4"
                    Content="💾 Save Memory"
                    Command="{Binding SaveCommand}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Padding="20,10" FontSize="13" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
